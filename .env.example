# Cozi MCP — self-hosted HTTP deployment environment variables.
# Copy to `.env` for local runs (npm run dev:http), or set these as environment
# variables on your host (Railway → service → Variables). Never commit real
# values — `.env` / `*.env` are gitignored.

# --- Required: your Cozi account -------------------------------------------
# These are read once at process startup and live only in this process's
# environment. They never reach the connecting client (e.g. ChatGPT).
COZI_USERNAME=you@example.com
COZI_PASSWORD=your-cozi-password

# --- Gate the public endpoint (pick ONE; both work, path-secret wins) -------
# The endpoint is reachable by anyone who learns the URL, so gate it.
#
# Option 1 — header gate (stronger). Every request must send
#   Authorization: Bearer <this value>
# Use for clients that can attach a static header. Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Option 2 — path gate (for clients that CANNOT send a header, e.g. ChatGPT's
# custom connector, which only offers OAuth or "No authentication"). When set,
# the endpoint moves to  <MCP_PATH>/<secret>  and the bare base path 404s;
# clients connect with "No authentication" and the unguessable path is the
# credential. Weaker than a header (URLs leak into logs/history) but effective.
# When set, the bearer check is not additionally required. Generate: openssl rand -hex 32
MCP_PATH_SECRET=

# --- Optional --------------------------------------------------------------
# Expose only read tools; hide create/update/delete. true/false, 1/0, yes/no.
COZI_READ_ONLY=false

# Path the MCP endpoint is served at. Making this unguessable is cheap
# defense-in-depth if you cannot use a bearer token.
MCP_PATH=/mcp

# Host/port the server binds to. Hosts like Railway inject PORT automatically;
# you normally do not need to set these.
# PORT=8080
# HOST=0.0.0.0
